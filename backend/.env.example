# Copie para .env e preencha. Nunca commite o .env. Valores abaixo são PLACEHOLDERS.
# Migrate one-shot (antes de scale): docker compose --profile migrate run --rm migrate
#
# production: JWT_SECRET >=32 chars (não fraco), ADMIN_PASSWORD != changeme,
# CORS_ORIGINS sem '*', CREATE_TABLES_ON_STARTUP=false, DATABASE_URL Postgres (não SQLite).

# ── Obrigatórias no docker compose (sem default) ─────────────────────────────
# local | test | production
ENVIRONMENT=production
# Só caracteres URL-safe (entra na DATABASE_URL montada pelo compose).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=troque-por-senha-forte-do-postgres
# >= 32 chars. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-por-um-valor-seguro-com-pelo-menos-32-chars
# Senha do admin inicial (python -m app.cli create-admin)
ADMIN_PASSWORD=altere-esta-senha

# ── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=vitrine
POSTGRES_DB=vitrine
# No compose a DATABASE_URL é montada a partir de POSTGRES_*. Defina só fora do compose
# (dev local / CLI), ex.: postgresql+psycopg2://vitrine:<senha>@localhost:5432/vitrine
# DATABASE_URL=

# ── Auth / sessão ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@vitrine.local
# Sem refresh token: o login vale por este tempo. Recomendado em prod: 720 (um turno de 12h).
JWT_EXPIRE_MINUTES=720

# ── HTTP / proxy ─────────────────────────────────────────────────────────────
# Hosts que o navegador usa para acessar o sistema na LAN (IP e/ou hostname da VM)
# + 127.0.0.1 (healthcheck do container). Ex.: 192.168.0.50,vitrine.lan,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# Origem única (front + /api no mesmo nginx) não precisa de CORS, mas o valor não pode
# ser vazio nem '*' em produção. Use a(s) URL(s) do front, ex.: http://192.168.0.50
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# Sub-rede fixa da rede interna do compose (rede `vitrine`).
VITRINE_SUBNET=172.28.0.0/16
# IPs/CIDRs do proxy confiável (X-Forwarded-For). Em prod use a sub-rede acima.
# Default seguro fora do compose: 127.0.0.1. Nunca "*".
FORWARDED_ALLOW_IPS=172.28.0.0/16
# Workers gunicorn (≈ núcleos da VM; 2 é suficiente para a loja)
WEB_CONCURRENCY=2

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
# Vazio (recomendado com origem única): imageUrl volta relativo, ex. /uploads/products/<arquivo>,
# e funciona tanto por IP quanto por hostname. Preencha só se as imagens vierem de outra origem.
PUBLIC_BASE_URL=
# Resolução máxima aceita no upload (largura × altura). 40 MP cobre qualquer celular.
MAX_IMAGE_PIXELS=40000000

# Em produção DEVE ser false — use: docker compose --profile migrate run --rm migrate
CREATE_TABLES_ON_STARTUP=false

# ── Observabilidade (opcional) ───────────────────────────────────────────────
# Vazio = Sentry desligado. Só erros 5xx / não tratados viram evento (sem PII).
# SENTRY_DSN=
# Fração de traces de performance (0.0–1.0). Em loja local, 0.0 costuma bastar.
SENTRY_TRACES_SAMPLE_RATE=0.0
