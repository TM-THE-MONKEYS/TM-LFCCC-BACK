# Copie para .env e preencha. Nunca commite o .env.
# Migrate one-shot (antes de scale): docker compose --profile migrate run --rm migrate
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg2://vitrine:vitrine@db:5432/vitrine
JWT_SECRET=troque-este-segredo-por-um-valor-seguro-com-pelo-menos-32-chars
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_EMAIL=admin@vitrine.local
ADMIN_PASSWORD=altere-esta-senha
CREATE_TABLES_ON_STARTUP=false
