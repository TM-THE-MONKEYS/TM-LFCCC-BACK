# ── Local development environment (SQLite — no PostgreSQL required) ──────────
# Copy this file to .env and run: uvicorn app.main:app --reload
#
# Commands (run from backend/ directory):
#   pip install -r requirements.txt
#   uvicorn app.main:app --reload --port 8000
#   python -m app.seed        (optional seed data)
#
# Swagger UI: http://localhost:8000/docs
# Health:     http://localhost:8000/health

DATABASE_URL=sqlite:///./vitrine.db
JWT_SECRET=dev-secret-local
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
AUTH_REQUIRED=false
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_EMAIL=admin@vitrine.local
ADMIN_PASSWORD=changeme

# Automatically creates all database tables on startup (SQLAlchemy create_all).
# Use this instead of running Alembic migrations when developing locally.
# Set to false in production (docker compose runs alembic upgrade head).
CREATE_TABLES_ON_STARTUP=true
