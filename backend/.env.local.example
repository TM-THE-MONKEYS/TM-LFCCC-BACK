# ── Local development environment (SQLite — no PostgreSQL required) ──────────
# Copy this file to .env and run: uvicorn app.main:app --reload
#
# Commands (run from backend/ directory):
#   pip install -e ".[dev]"
#   uvicorn app.main:app --reload --port 8000
#   python -m app.cli create-admin
#   python -m app.seed        (optional seed data — não use senha padrão em prod)
#
# Swagger UI: http://localhost:8000/docs
# Health:     http://localhost:8000/health

ENVIRONMENT=local
DATABASE_URL=sqlite:///./vitrine.db
JWT_SECRET=dev-secret-troque-em-producao-minimo-32-chars
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_EMAIL=admin@vitrine.local
ADMIN_PASSWORD=changeme

# Automatically creates all database tables on startup (SQLAlchemy create_all).
# Use this instead of running Alembic migrations when developing locally.
# In Docker/prod: CREATE_TABLES_ON_STARTUP=false and run migrate profile first:
#   docker compose --profile migrate run --rm migrate
CREATE_TABLES_ON_STARTUP=true
