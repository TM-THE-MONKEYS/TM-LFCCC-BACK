# Copie para .env nesta pasta (deploy/.env) e preencha.
# Nunca commite o .env. Valores abaixo são PLACEHOLDERS.

# ── Imagens GHCR ─────────────────────────────────────────────────────────────
# Tag publicada pelo CI (sha curto ou latest). Ex.: abcdef1 ou latest
APP_TAG=latest
# Porta HTTP no host da VM (nginx do front)
FRONT_HOST_PORT=80

# ── Obrigatórias ─────────────────────────────────────────────────────────────
# Senha Postgres — só caracteres URL-safe (letras, dígitos, - _ . ~).
# Gere: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=troque-por-senha-forte-do-postgres
# JWT >= 32 chars. Gere: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-por-um-valor-seguro-com-pelo-menos-32-chars
# Senha do admin inicial (create-admin / bootstrap)
ADMIN_PASSWORD=altere-esta-senha-forte

# ── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=vitrine
POSTGRES_DB=vitrine

# ── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@vitrine.local
# Sem refresh token: duração da sessão. Recomendado: 720 (12h). Máx. prod: 1440.
JWT_EXPIRE_MINUTES=720

# ── HTTP / LAN (OBRIGATÓRIO ajustar na VM) ───────────────────────────────────
# IP ou hostname que o navegador usa + 127.0.0.1 (healthcheck interno).
# Ex.: 192.168.0.50,vitrine.lan,127.0.0.1
ALLOWED_HOSTS=192.168.0.50,127.0.0.1
# URL(s) do front na LAN (mesmo host:porta que o usuário abre). Sem '*'.
# Ex.: http://192.168.0.50
CORS_ORIGINS=http://192.168.0.50

# Rede interna do compose (proxy → API). Não mude sem alinhar FORWARDED_ALLOW_IPS.
VITRINE_SUBNET=172.28.0.0/16
FORWARDED_ALLOW_IPS=172.28.0.0/16

WEB_CONCURRENCY=2

# ── Uploads ──────────────────────────────────────────────────────────────────
# Vazio = imageUrl relativo (/uploads/...) — recomendado com origem única.
PUBLIC_BASE_URL=
MAX_IMAGE_PIXELS=40000000

# ── Backup local (serviço db-backup) ─────────────────────────────────────────
# 86400 = 1 dia. Retenção em dias (find -mtime).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# ── Observabilidade (opcional) ───────────────────────────────────────────────
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
